{
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "useUnknownInCatchVariables": true,
    "lib": [
      "deno.ns",
      "dom",
      "dom.iterable",
      "esnext"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.14",
    "/p/": "file:///workspace/packages/",
    "@the8020/kernel": "file:///opt/runtime/kernel/mod.ts",
    "@the8020/protocol": "file:///opt/runtime/protocol.ts",
    "@the8020/context": "file:///opt/runtime/context/mod.ts"
  },
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check --import-map=deno.local.json mod.ts codecs.ts lookup.ts types/*.ts internal/*.ts src/*.ts programs/*/*.ts",
    "test": "deno test --import-map=deno.local.json --allow-read=. ."
  }
}
